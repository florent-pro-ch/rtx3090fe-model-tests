{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign.schema.json",
  "title": "A dated campaign",
  "type": "object",
  "required": [
    "campaign_id",
    "date",
    "title",
    "status"
  ],
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "modes": {
      "type": "array"
    },
    "benches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "closed",
        "partial",
        "exploratory",
        "not-run"
      ]
    },
    "n_runs": {
      "type": "integer"
    },
    "has_frozen_bench": {
      "type": "boolean"
    },
    "n_copies": {
      "type": "integer"
    },
    "scores_withheld": {
      "type": "string",
      "minLength": 1,
      "description": "Present when this campaign's scores and rankings are withheld by the publication policy (the medical-imaging bench, until the review of its data-use agreement's publication clause): the public note that stands where the scores were."
    }
  }
}
