{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runs-index.schema.json",
  "title": "Compact index of every run record, for the site",
  "description": "data/indexes/runs.json, generated by the exporter from data/runs/. Each entry repeats fields of one run record; the record is authoritative, and tools/validate.py checks that the two agree.",
  "type": "object",
  "required": ["generated_by", "n", "runs"],
  "properties": {
    "generated_by": {"const": "runs"},
    "n": {"type": "integer", "minimum": 0, "description": "Number of entries, copies included; must equal the length of runs."},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "model_id", "build_id", "hardware", "status", "kind", "engine", "pre_pin", "duplicate_of"],
        "properties": {
          "run_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[^/]+/.+$"},
          "model_id": {"type": "string"},
          "build_id": {"type": ["string", "null"]},
          "hardware": {"enum": ["1x3090fe", "2x3090fe-nvlink", "2x2x3090fe-nvlink", "cpu-only", "unknown"]},
          "status": {"type": "string"},
          "kind": {"type": "string"},
          "protocol": {"type": ["string", "null"]},
          "engine": {"type": "string"},
          "engine_version": {"type": ["string", "null"]},
          "pre_pin": {"type": ["boolean", "null"], "description": "true: an engine older than the 2026-09-10 pin; false: a pinned engine; null: the engine is unknown or withheld."},
          "started_at": {"type": ["string", "null"]},
          "solo_tok_s": {"type": ["number", "null"]},
          "agg_tok_s": {"type": ["number", "null"]},
          "agg_concurrency": {"type": ["integer", "null"]},
          "vram_mib_per_gpu": {"type": "array", "items": {"type": ["number", "null"]}},
          "split": {"type": "string"},
          "gpus": {"type": ["integer", "null"]},
          "duplicate_of": {"type": ["string", "null"]}
        }
      }
    }
  }
}
