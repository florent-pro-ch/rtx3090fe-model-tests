{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "watchlist.schema.json",
  "title": "Models spotted but never run on the rig, each with the reason",
  "description": "data/watchlist.json, generated by the exporter from the lab's inventory: entries spotted but not run on the rig when the list was written. route separates local weights from cloud or API-only models and from tools; an entry measured afterwards says so in measured_later.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "count",
    "counts",
    "entries",
    "source"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of entries; must equal the length of entries."
    },
    "counts": {
      "type": "object",
      "description": "Entries per route, and how many were measured later; each must equal the count over entries.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "model_id",
          "reason",
          "reason_code",
          "route"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The model record, when the model has one; null otherwise."
          },
          "route": {
            "enum": [
              "local-weights",
              "cloud-api",
              "tool"
            ],
            "description": "local-weights: weights spotted for the rig; cloud-api: a cloud or API-only model; tool: not a model."
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "measured_later": {
            "type": "boolean"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src-[0-9a-f]{16}$"
        }
      }
    }
  }
}
