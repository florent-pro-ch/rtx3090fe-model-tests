{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comparison.schema.json",
  "title": "A cross-run comparison: one question, the rows that answer it, and every row tied to its runs and evidence",
  "description": "data/comparisons/<comparison_id>.json. Every figure is a row; a row names the run records it was computed from (run_ids) and the evidence it was read from (evidence: paths in this repository, or this record itself for a figure the exporter computed). Comparisons are generated by the exporter, never hand-edited.",
  "type": "object",
  "required": [
    "comparison_id",
    "title",
    "question",
    "method",
    "caveats",
    "rows",
    "verdict",
    "hardware",
    "model_id",
    "sources"
  ],
  "properties": {
    "comparison_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1
    },
    "hardware": {
      "description": "The hardware configuration(s) the comparison covers.",
      "anyOf": [
        {
          "$ref": "#/$defs/hardware_id"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hardware_id"
          }
        }
      ]
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "The one model compared, or null when the comparison spans several."
    },
    "excluded_counts": {
      "type": "object",
      "description": "Runs left out of the comparison, counted by reason.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "summary_note": {
      "type": "string",
      "description": "How to read summary_rows."
    },
    "summary_rows": {
      "type": "array",
      "description": "Optional per-target summary of the rows (for example the base and best arm of each speculative-decoding target), each tied to its runs and evidence like a row.",
      "items": {
        "type": "object",
        "required": [
          "run_ids",
          "evidence"
        ],
        "properties": {
          "run_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(evidence|data)/"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^src-[0-9a-f]{16}$"
          }
        }
      }
    }
  },
  "$defs": {
    "hardware_id": {
      "enum": [
        "1x3090fe",
        "2x3090fe-nvlink",
        "2x2x3090fe-nvlink"
      ]
    },
    "row": {
      "type": "object",
      "required": [
        "label",
        "metric",
        "value",
        "unit",
        "run_ids",
        "evidence"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "description": "null when the arm produced no figure (for example a failed start); the row says why."
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(evidence|data)/"
          }
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "concurrency": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "n_passes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "kept": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "identity_ok": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "vram_kind": {
          "enum": [
            "reserved",
            "after-load",
            "unknown",
            null
          ]
        },
        "gpus": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "parallel_slots": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
