{
  "docker_options": [
    "-d",
    "--ipc=host"
  ],
  "engine_args": [
    "--model",
    "$MODELS/minicpm5-2b",
    "--tensor-parallel-size",
    "1",
    "--max-model-len",
    "32768",
    "--max-num-seqs",
    "8",
    "--max-num-batched-tokens",
    "8192",
    "--gpu-memory-utilization",
    "0.90",
    "--kv-cache-dtype",
    "fp8",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "minicpm5",
    "--reasoning-parser",
    "qwen3",
    "--served-model-name",
    "minicpm5-2b"
  ],
  "env": {},
  "gpus_device_list": [
    0
  ],
  "image": "vllm/vllm-openai:v0.26.0",
  "kind": "docker",
  "parse_notes": [],
  "scrubbed": [
    "container_name",
    "host",
    "model_path",
    "port",
    "ports",
    "volumes"
  ]
}
