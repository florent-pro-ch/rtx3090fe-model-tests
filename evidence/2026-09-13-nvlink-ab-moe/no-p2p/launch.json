{
  "docker_options": [
    "-d",
    "--ipc=host"
  ],
  "engine_args": [
    "--model",
    "$MODELS/Qwen3.6-35B-A3B-AWQ",
    "--served-model-name",
    "moe-nvlink-ab",
    "--tensor-parallel-size",
    "2",
    "--quantization",
    "awq_marlin",
    "--gpu-memory-utilization",
    "0.88",
    "--max-model-len",
    "8192",
    "--max-num-batched-tokens",
    "8192"
  ],
  "env": {
    "NCCL_DEBUG": "INFO",
    "NCCL_P2P_DISABLE": "1"
  },
  "gpus_device_list": [
    0,
    1
  ],
  "image": "vllm/vllm-openai:v0.29.0",
  "kind": "docker",
  "moe_kernel_config_mounted": true,
  "parse_notes": [],
  "scrubbed": [
    "container_name",
    "host",
    "model_path",
    "port",
    "ports",
    "volumes"
  ]
}
