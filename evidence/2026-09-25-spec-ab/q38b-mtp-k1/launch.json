{
  "docker_options": [
    "-d",
    "--ipc=host"
  ],
  "engine_args": [
    "--model",
    "$MODELS/qwen38-base-w4a16",
    "--tensor-parallel-size",
    "2",
    "--max-model-len",
    "32768",
    "--max-num-seqs",
    "8",
    "--max-num-batched-tokens",
    "8192",
    "--gpu-memory-utilization",
    "0.92",
    "--kv-cache-dtype",
    "fp8",
    "--no-enable-prefix-caching",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "qwen3_xml",
    "--reasoning-parser",
    "qwen3",
    "--speculative-config",
    "{\"method\":\"mtp\",\"num_speculative_tokens\":1}",
    "--served-model-name",
    "qwen38-base"
  ],
  "env": {},
  "gpus_device_list": [
    0,
    1
  ],
  "image": "vllm/vllm-openai:v0.29.0",
  "kind": "docker",
  "parse_notes": [],
  "scrubbed": [
    "container_name",
    "host",
    "labels",
    "model_path",
    "port",
    "ports",
    "volumes"
  ]
}
