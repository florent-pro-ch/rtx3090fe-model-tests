{
  "docker_options": [
    "-d",
    "--ipc=host"
  ],
  "engine_args": [
    "--model",
    "$MODELS/surya-ocr-2.5",
    "--tensor-parallel-size",
    "1",
    "--max-model-len",
    "24576",
    "--max-num-seqs",
    "4",
    "--max-num-batched-tokens",
    "2048",
    "--limit-mm-per-prompt",
