    "{\"min_pixels\": 3136, \"max_pixels\": 6291456}",
    "--chat-template",
    "$MODELS/chat_template_image_first.jinja",
    "--served-model-name",
    "surya-ocr-2.5"
  ],
  "env": {},
  "gpus_device_list": [
    0
  ],
  "image": "vllm/vllm-openai:v0.29.0",
  "kind": "docker",
  "parse_notes": [],
  "scrubbed": [
    "container_name",
    "host",
    "model_path",
    "port",
    "ports",
    "volumes"
  ]
