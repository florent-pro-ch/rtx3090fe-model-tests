{
  "docker_options": [
    "-d",
    "--ipc=host"
  ],
  "engine_args": [
    "--model",
    "$MODELS/GLM-4.7-Flash-AWQ-4bit",
    "--tensor-parallel-size",
    "2",
    "--max-model-len",
    "16384",
    "--max-num-seqs",
    "8",
    "--max-num-batched-tokens",
    "8192",
    "--gpu-memory-utilization",
    "0.90",
    "--kv-cache-dtype",
    "bfloat16",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "glm47",
    "--reasoning-parser",
    "glm45",
    "--served-model-name",
    "glm-4.7-flash"
  ],
  "env": {},
  "gpus_device_list": [
    0,
    1
  ],
  "image": "vllm/vllm-openai:v0.26.0",
  "kind": "docker",
  "parse_notes": [],
  "scrubbed": [
    "container_name",
    "host",
    "model_path",
    "port",
    "ports",
    "volumes"
  ]
}
