{
  "docker_options": [
    "-d",
    "--ipc=host"
  ],
  "engine_args": [
    "--model",
    "$MODELS/oui-1",
    "--trust-remote-code",
    "--enforce-eager",
    "--tensor-parallel-size",
    "2",
    "--dtype",
    "bfloat16",
    "--cpu-offload-gb",
    "8",
    "--max-model-len",
    "16384",
    "--max-num-batched-tokens",
    "2048",
    "--max-num-seqs",
    "2",
    "--gpu-memory-utilization",
    "0.85",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "gemma4",
    "--limit-mm-per-prompt",
    "{\"image\":0,\"video\":0,\"audio\":0}",
    "--attention-backend",
    "TRITON_ATTN",
    "--served-model-name",
    "oui-1"
  ],
  "env": {},
  "gpus_device_list": [
    0,
    1
  ],
  "image": "vllm/vllm-openai:v0.29.0",
  "kind": "docker",
  "parse_notes": [],
  "scrubbed": [
    "container_name",
    "host",
    "model_path",
    "port",
    "ports",
    "volumes"
  ]
}
