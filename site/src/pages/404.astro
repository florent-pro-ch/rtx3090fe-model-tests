---
import Layout from '../layouts/Layout.astro';
import { href } from '../lib/site';
---
{/* served at any missing address: its canonical and og:url name the home page, never /404/ */}
<Layout title="Not found" description="This page does not exist." noindex canonicalPath={href('/')}>
  <h1>Not found</h1>
  <p>This page does not exist (or no longer does). Try the <a href={href('models/')}>models</a> or the <a href={href('/')}>home page</a>.</p>
</Layout>
