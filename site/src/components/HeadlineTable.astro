---
/**
 * The headline table of a configuration: one row per model (headline-run
 * rule), sorted by single-stream speed, with the build (quantisation) and the
 * protocol of each figure, VRAM per GPU and its meaning, engine and version
 * with the pre-pin badge, the split mode, and the date linking to the run.
 * Where some headline run measured them (the 2026-10-03 speed campaign and,
 * since 2026-10-04, model-watch runs: English pass only, no second French pass), two
 * more columns show that same run's English twin (en_solo_tok_s, measured in
 * the same session) and its tokens per joule at eight requests
 * (agg_tok_per_j): beside the headline figure, never a value from another
 * run. Without one, the English cell reads "other protocol" when the headline
 * run is not the house protocol (its own English figures, if any, stay on its
 * run page: another protocol, not comparable); either cell reads "other run",
 * a link, when a run of the same model, configuration and split mode measured
 * it but is not the headline (the rule chose another run); "not measured"
 * otherwise. Each column appears when some row has its figure or an "other
 * run" link. An English figure whose language difference is called but whose
 * answer stopped earlier than the French ones carries the fixed caveat
 * "language and answer length are not separated" (englishLengthCaveat).
 * The rule's own text (methodology/headline-rule.md) is the note under it.
 */
import Num from './Num.astro';
import AggCell from './AggCell.astro';
import Table from './Table.astro';
import Vram from './Vram.astro';
import PrePinBadge from './PrePinBadge.astro';
import SplitBadge from './SplitBadge.astro';
import HeadlineRule from './HeadlineRule.astro';
import CtxCell from './CtxCell.astro';
import type { Run } from '../lib/data';
import { isNum, modelById, modelName, runDate, soloTokS, ttftMs, vramPerGpu, isHouseProtocol, buildLabel, repetitions, servedContext, readySeconds, kvPoolTokens, readyWithDebug, aggSlots, runsOfModel, splitGroup, englishLengthCaveat, LANGUAGE_LENGTH_CAVEAT } from '../lib/data';
import { configHref, engineLabel, glossaryHref, href, modelHref, runHref } from '../lib/site';
import { hardwareById } from '../lib/data';

interface Props { heads: { model_id: string; run: Run }[]; label?: string; showSplit?: boolean; firstCol?: 'model' | 'config'; rule?: boolean }
const { heads, label = 'headline runs', showSplit = true, firstCol = 'model', rule = true } = Astro.props;
const anyOther = heads.some(({ run }) => !isHouseProtocol(run.protocol));
const anyKv = heads.some(({ run }) => kvPoolTokens(run) !== null);
const anySerial = heads.some(({ run }) => aggSlots(run).serialised && isNum(run.metrics.agg_tok_s));
// What a cell of the English and tokens-per-joule columns shows when the headline run lacks the figure.
type Side = { kind: 'value' } | { kind: 'other-protocol'; own: boolean } | { kind: 'other-run'; run: Run } | { kind: 'none' };
const ENGLISH_KEY = /(^|_)en_/;
function side(model_id: string, run: Run, key: string, protocolCell: boolean): Side {
  if (isNum(run.metrics[key])) return { kind: 'value' };
  if (!isHouseProtocol(run.protocol)) {
    return protocolCell ? { kind: 'other-protocol', own: Object.keys(run.metrics).some((k) => ENGLISH_KEY.test(k) && isNum(run.metrics[k])) } : { kind: 'none' };
  }
  const others = runsOfModel(model_id)
    .filter((o) => o.run_id !== run.run_id && o.hardware === run.hardware && !o.duplicate_of && splitGroup(o) === splitGroup(run) && isNum(o.metrics[key]))
    .sort((a, b) => (runDate(b) ?? '').localeCompare(runDate(a) ?? '') || a.run_id.localeCompare(b.run_id));
  return others.length ? { kind: 'other-run', run: others[0] } : { kind: 'none' };
}
const sides = new Map(heads.map(({ model_id, run }) => [run.run_id, { en: side(model_id, run, 'en_solo_tok_s', true), tpj: side(model_id, run, 'agg_tok_per_j', false) }]));
// A column appears when a headline run has its figure (read from that run only, never a value from another run) or
// when another run of a row measured it (an "other run" link to it), so a page whose rows all link elsewhere keeps it.
const anyEn = [...sides.values()].some((x) => x.en.kind === 'value' || x.en.kind === 'other-run');
const anyTpj = [...sides.values()].some((x) => x.tpj.kind === 'value' || x.tpj.kind === 'other-run');
// English single-stream figures under the fixed caveat (englishLengthCaveat in lib/data.ts).
const anyEnCaveat = anyEn && heads.some(({ run }) => englishLengthCaveat(run, 'solo'));
const anyOtherProtocolCell = anyEn && [...sides.values()].some((x) => x.en.kind === 'other-protocol');
const anyOtherRunCell = [...sides.values()].some((x) => (anyEn && x.en.kind === 'other-run') || (anyTpj && x.tpj.kind === 'other-run'));
---
<Table label={label} search={heads.length > 8}>
  <table>
    <thead>
      <tr>
        <th scope="col" data-sort>{firstCol === 'model' ? 'Model' : 'Configuration'}</th>
        <th scope="col" data-sort>Build</th>
        <th scope="col" class="num" data-sort="num">Single stream</th>
        <th scope="col" class="num" data-sort="num">Aggregate</th>
        <th scope="col" class="num" data-sort="num">TTFT</th>
        {anyEn && <th scope="col" class="num" data-sort="num" title="the same single-stream pass with the prompt in English (speed-house/v1-en), same server, same session; beside the headline figure, never the headline">English (same session)</th>}
        {anyTpj && <th scope="col" class="num" data-sort="num" title="tokens per joule of the eight-request pass: the GPU boards' energy (NVML counter) of the cards the model used, summed; not the host">Tokens per joule at 8</th>}
        <th scope="col" class="num" data-sort="num" title="context one request could use: max_model_len (vLLM); for llama.cpp, ctx_size divided by the slots (-np), since llama.cpp splits its context across them (the total is in each cell's tooltip)">Context</th>
        <th scope="col" class="num" data-sort="num" title="seconds from launch to a ready server">Ready</th>
        {anyKv && <th scope="col" class="num" data-sort="num" title="KV-cache pool the engine logged, in tokens">KV pool</th>}
        <th scope="col" class="num" data-sort="num">VRAM per GPU</th>
        <th scope="col" data-sort>Engine</th>
        {showSplit && <th scope="col" data-sort>Split</th>}
        <th scope="col" data-sort>Protocol</th>
        <th scope="col" data-sort>Date</th>
      </tr>
    </thead>
    <tbody>
      {heads.map(({ model_id, run }) => {
        const m = modelById().get(model_id);
        const vr = vramPerGpu(run);
        const house = isHouseProtocol(run.protocol);
        const reps = repetitions(run);
        return (
          <tr>
            <td><div class="cell-min">{firstCol === 'config'
              ? <a href={configHref(run.hardware)}>{hardwareById(run.hardware)?.label ?? run.hardware}</a>
              : m ? <a href={modelHref(m.slug)}>{m.name}</a> : <span>{modelName(model_id)}</span>}</div></td>
            <td class="small"><span title={run.build_id ?? 'build not recorded'}>{buildLabel(run)}</span></td>
            <td class="num" data-v={String(soloTokS(run))}><Num value={soloTokS(run)} unit="tok/s" run={run.run_id} /></td>
            <td class="num" data-v={isNum(run.metrics.agg_tok_s) ? String(run.metrics.agg_tok_s) : ''}><AggCell run={run} /></td>
            <td class="num" data-v={ttftMs(run) ?? ''}><Num value={ttftMs(run)} unit="ms" run={run.run_id} nullText="—" /></td>
            {anyEn && <td class="num" data-v={isNum(run.metrics.en_solo_tok_s) ? String(run.metrics.en_solo_tok_s) : ''}>{(() => {
              const sd = sides.get(run.run_id)!.en;
              if (sd.kind === 'other-protocol') return <a class="muted small" href={runHref(run.run_id)} title={`headline run under another protocol (${run.protocol ?? 'none recorded'})${sd.own ? ', which reports English figures of its own: on its run page, not comparable with this column' : ', with no English figure'}; run ${run.run_id}`}>other protocol</a>;
              if (sd.kind === 'other-run') return <a class="muted small" href={runHref(sd.run.run_id)} title={`measured in run ${sd.run.run_id}, which is not this row's headline run (the headline rule chose another run): its figures are on its run page`}>other run</a>;
              return <><Num value={run.metrics.en_solo_tok_s} unit="tok/s" run={run.run_id} nullText="not measured" />{isNum(run.metrics.en_solo_tok_s) && isNum(run.metrics.en_solo_completion_tokens) && <><br /><span class="muted small"><Num value={run.metrics.en_solo_completion_tokens} unit="tokens" run={run.run_id} /></span></>}{englishLengthCaveat(run, 'solo') && <><br /><span class="flag" title="the English figure differs from the French one beyond the reading rule fixed before the first pass, but the English answer stopped before the token count the French answers reached: the run page has both counts">{LANGUAGE_LENGTH_CAVEAT}</span></>}</>;
            })()}</td>}
            {anyTpj && <td class="num" data-v={isNum(run.metrics.agg_tok_per_j) ? String(run.metrics.agg_tok_per_j) : ''}>{(() => {
              const sd = sides.get(run.run_id)!.tpj;
              if (sd.kind === 'other-run') return <a class="muted small" href={runHref(sd.run.run_id)} title={`measured in run ${sd.run.run_id}, which is not this row's headline run (the headline rule chose another run): its figures are on its run page`}>other run</a>;
              return <><Num value={run.metrics.agg_tok_per_j} unit="tok/J" run={run.run_id} nullText="not measured" />{isNum(run.metrics.agg_tok_per_j) && run.topology.ram_spill === true && <><br /><span class="muted small" title="part of the model sat in system RAM, whose energy is not counted (GPU boards only): this figure flatters the machine">model partly in RAM</span></>}</>;
            })()}</td>}
            <td class="num" data-v={servedContext(run) ?? ''}><CtxCell run={run} /></td>
            <td class="num" data-v={readySeconds(run) ?? ''}><Num value={readySeconds(run)} unit="s" run={run.run_id} nullText="—" />{readyWithDebug(run) && <sup class="muted" title="ready time measured with NCCL debug logging on: not comparable with other runs">*</sup>}</td>
            {anyKv && <td class="num" data-v={kvPoolTokens(run) ?? ''}><Num value={kvPoolTokens(run)} unit="tokens" run={run.run_id} nullText="—" /></td>}
            <td class="num" data-v={vr.length ? String(Math.max(...vr)) : ''}><Vram run={run} /></td>
            <td><span class="mono small engine">{engineLabel(run.engine)}</span> <PrePinBadge prePin={run.engine.pre_pin} /></td>
            {showSplit && <td><SplitBadge run={run} /></td>}
            <td class="small nowrap" data-v={run.protocol ?? ''}>
              <span class="mono">{run.protocol ?? 'no protocol'}</span>
              {!house && <><br /><a class="badge plain tone-amber badge-link" href={href('methodology/#headline-run-rule')} title="not the house speed protocol: not directly comparable with the house-protocol rows">other protocol</a></>}
              {reps > 1 && <><br /><span class="muted"><Num value={reps} run={run.run_id} /> repetitions</span></>}
            </td>
            <td class="mono small nowrap" data-v={runDate(run) ?? ''}><a href={runHref(run.run_id)} title={`run ${run.run_id}`}>{runDate(run) ?? 'undated'}</a></td>
          </tr>
        );
      })}
    </tbody>
  </table>
</Table>
{anySerial && <p class="small muted">An aggregate marked <em>1 slot (serialised)</em> comes from a llama.cpp server started with one slot (<code>-np 1</code>): the eight requests were served one after another, so it is single-stream speed, not batching. llama.cpp runs with 4 or 8 slots are in the run lists.</p>}
{heads.some(({ run }) => readyWithDebug(run)) && <p class="small muted">* Ready time measured with NCCL debug logging on: not comparable with other runs.</p>}
{(anyEn || anyTpj) && <p class="small muted">English: the same pass with the prompt in English (<code>speed-house/v1-en</code>), same server, same session, beside the French figure and never in its place. Energy: NVML board energy of the cards used, summed over both cards on a pair; not the host. Under the house protocol the English twin, like energy per token, exists only for runs measured in the 2026-10-03 speed campaign and, since 2026-10-04, in model-watch runs (English pass only, no second French pass, so no language difference is called or ruled out for them); a headline run without it reads <em>not measured</em>.{anyOtherProtocolCell && <> <em>Other protocol</em>: the headline run was measured under another protocol (named in the Protocol column); English figures of its own, where it has some, are on its run page and are not comparable with this column.</>}{anyOtherRunCell && <> <em>Other run</em>: another run of the model, on this configuration and split mode, measured it, but the headline rule chose a different run (one with repeated passes before a single pass, for example); the link leads to the run that measured it.</>}{anyEnCaveat && <> Marked <em>{LANGUAGE_LENGTH_CAVEAT}</em>: the English figure differs from the French one beyond the reading rule fixed before the first pass (more than twice the gap between the two French passes and more than 3 %), but the English answer stopped before the token count every French answer reached.</>}</p>}
{anyOther && <p class="small muted">Rows marked <em>other protocol</em> were not measured under the house speed protocol (<code>speed-house/v1</code>); see <a href={glossaryHref('speed-house/v1')}>the glossary</a> and the protocol notes in the methodology.</p>}
{rule && <HeadlineRule compact />}
